# ============================================================
#  App Store de GitHub — Backend (FastAPI)
#  Copia este archivo a ".env" y rellena tus claves reales.
# ============================================================

# Token de GitHub (opcional pero MUY recomendado para evitar rate limits).
# Crea uno en: https://github.com/settings/tokens  (permiso: solo lectura publico)
GITHUB_TOKEN=

# Proveedor de IA: "openai", "anthropic", "groq" o "gemini"
AI_PROVIDER=gemini

# API Key del proveedor de IA
#   groq   -> claves tipo gsk_...
#   gemini -> clave de Google AI Studio (API key)
AI_API_KEY=

# Modelo a usar (ajusta según tu proveedor)
#   openai  -> gpt-4o-mini
#   anthropic -> claude-3-5-sonnet-latest
#   groq   -> openai/gpt-oss-20b  (free tier, rápido)
#   gemini -> gemini-flash-lite-latest  (por defecto si AI_PROVIDER=gemini;
#             cuota gratuita diaria mucho más generosa que "gemini-X-flash")
AI_MODEL=gemini-flash-lite-latest

# --- Proveedor de RESPALDO (opcional pero recomendado) ---
# Si el proveedor principal falla por cuota agotada, timeout o error, ese
# repo puntual se reintenta con este segundo proveedor/clave antes de
# rendirse al fallback "Análisis pendiente". Combina la cuota gratuita de
# dos servicios distintos. Groq es gratis, sin tarjeta, y muy generoso:
# crea tu clave en https://console.groq.com/keys (2 minutos).
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=openai/gpt-oss-20b

# Cuántas llamadas al LLM se disparan en paralelo por búsqueda.
# Por defecto: 5 para gemini, 8-10 para el resto. Súbelo si tu cuota lo permite.
AI_CONCURRENCY=5

# Segundos máximos de espera por una respuesta del LLM antes de rendirse y
# usar el fallback (evita que una llamada colgada bloquee toda la búsqueda).
AI_CALL_TIMEOUT_SECONDS=30

# Minutos que se guarda en caché (en memoria) el resultado de una búsqueda
# ya procesada por IA, para no repetir el gasto de cuota con la misma
# consulta. 900s = 15 min. Pon 0 para desactivar la caché.
SEARCH_CACHE_TTL_SECONDS=900

# Rate limiting por IP: máximo de búsquedas permitidas por ventana de tiempo,
# para que una sola persona no agote la cuota compartida de IA/GitHub.
RATE_LIMIT_MAX_PETICIONES=10
RATE_LIMIT_VENTANA_SEGUNDOS=300

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Token del panel de administración (opcional). Si lo dejas vacío,
# GET /api/admin/stats responde 503 y el panel queda deshabilitado.
# Ponle un valor largo y aleatorio (ej. `openssl rand -hex 32`) y ábrelo en
# frontend/public/admin.html?api=<tu-backend>. Solo expone contadores
# agregados (nunca IPs ni texto de búsquedas por persona).
ADMIN_TOKEN=
